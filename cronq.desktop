[Desktop Entry]
Type=Application
Name=Cronq
GenericName=Floating Desktop Companion
Comment=Always-on-top non-focus-stealing browser and phone overlay
Exec=cronq-supervisor
Icon=cronq
Terminal=false
Categories=Utility;Network;Development;
Keywords=overlay;companion;chatgpt;browser;floating;always-on-top;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-Cinnamon-Autostart-enabled=true
X-MATE-Autostart-enabled=true
X-KDE-autostart-after=panel
